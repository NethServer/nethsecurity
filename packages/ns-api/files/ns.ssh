# Manage SSH configuration and authorized keys

import os
import sys
import json

from euci import EUci
from nethsec import users
from nethsec.utils import validation_error, ValidationError, generic_error


def __list_keys():
    keys = []
    if os.path.exists(KEYS_FILE):
        with open(KEYS_FILE, 'r') as file:
            for line in file:
                if line.startswith('#') or len(line.split()) < 2:
                    continue
                line_split = line.strip().split()
                keys.append({
                    'type': line_split[0],
                    'key': line_split[1],
                    'comment': ' '.join(line_split[2:])
                })
    return keys


def __is_on(value):
    return value in ("1", "on", "true", "yes", "enabled")


def __get_configuration(uci):
    # dropbear defaults both flags to on when unset
    password_auth = __is_on(uci.get("dropbear", "main", "PasswordAuth", default="1"))
    root_password_auth = __is_on(uci.get("dropbear", "main", "RootPasswordAuth", default="1"))
    gateway_ports = __is_on(uci.get("dropbear", "main", "GatewayPorts", default="0"))
    return {
        "Port": uci.get("dropbear", "main", "Port", default="22"),
        # PasswordAuth off disables password login for root too
        "RootPasswordAuth": "on" if password_auth and root_password_auth else "off",
        "GatewayPorts": "on" if gateway_ports else "off",
    }


def __set_configuration(uci):
    data = json.load(sys.stdin)
    for field in ("Port", "RootPasswordAuth", "GatewayPorts"):
        if field not in data:
            raise ValidationError(field, "required")
    port = str(data["Port"])
    port_is_valid = port.isdigit() and 1 <= int(port) <= 65535
    if not port_is_valid:
        raise ValidationError("Port", "invalid_port", data["Port"])
    for field in ("RootPasswordAuth", "GatewayPorts"):
        if data[field] not in ("on", "off"):
            raise ValidationError(field, "invalid_value", data[field])
    uci.set("dropbear", "main", "Port", str(data["Port"]))
    # root is the only SSH account, PasswordAuth follows RootPasswordAuth
    uci.set("dropbear", "main", "PasswordAuth", data["RootPasswordAuth"])
    uci.set("dropbear", "main", "RootPasswordAuth", data["RootPasswordAuth"])
    uci.set("dropbear", "main", "GatewayPorts", data["GatewayPorts"])
    uci.save("dropbear")


def __add_key():
    data = json.load(sys.stdin)
    if 'key' not in data:
        raise ValidationError('key', 'required')
    # NOTE: we are not validating the key format here, it can be done using `ssh-keygen -lf <keyfile>`, but it's
    # overkill and can be implemented later on if needed.
    if len(data['key'].split()) < 2:
        raise ValidationError('key', 'key_invalid_format', data['key'])
    if data['key'].split()[1] in [key['key'] for key in __list_keys()]:
        raise ValidationError('key', 'key_already_exists', data['key'])
    file_descriptor = os.open(
        KEYS_FILE,
        os.O_APPEND | os.O_WRONLY | os.O_CREAT,
        mode=0o600
    )
    with open(file_descriptor, 'w') as file:
        file.write(data['key'] + '\n')


def __delete_key():
    data = json.load(sys.stdin)
    if 'key' not in data:
        raise ValidationError('key', 'required')
    keys = __list_keys()
    if data['key'] not in [key['key'] for key in keys]:
        raise ValidationError('key', 'key_not_found', data['key'])
    with open(KEYS_FILE, 'w') as file:
        for key in keys:
            if key['key'] != data['key']:
                file.write(f"{key['type']} {key['key']} {key['comment']}\n")


KEYS_FILE = '/etc/dropbear/authorized_keys'

cmd = sys.argv[1]

if cmd == "list":
    print(
        json.dumps(
            {
                "get-configuration": {},
                "set-configuration": {"Port": "22", "RootPasswordAuth": "on", "GatewayPorts": "off"},
                "add-key": {"key": "string"},
                "delete-key": {"key": "string"},
            }
        )
    )
else:
    action = sys.argv[2]
    uci = EUci()
    # SSH is managed on the unit, the controller gets read-only access like ordinary admins
    caller_is_controller = os.environ.get("NS_API_USER") == uci.get("rpcd", "controller", "username", default="")
    can_write = users.caller_is_superuser(uci) and not caller_is_controller
    try:
        if action == "get-configuration":
            print(json.dumps({"configuration": __get_configuration(uci), "keys": __list_keys()}))
        elif action == "set-configuration":
            if not can_write:
                print(json.dumps(generic_error("forbidden")))
            else:
                __set_configuration(uci)
                print(json.dumps({"message": "success"}))
        elif action == "add-key":
            if not can_write:
                print(json.dumps(generic_error("forbidden")))
            else:
                __add_key()
                print(json.dumps({"message": "success"}))
        elif action == "delete-key":
            if not can_write:
                print(json.dumps(generic_error("forbidden")))
            else:
                __delete_key()
                print(json.dumps({"message": "success"}))
    except ValidationError as e:
        print(json.dumps(validation_error(e.parameter, e.message, e.value)))
    except Exception as e:
        print(json.dumps(generic_error(str(e))))
