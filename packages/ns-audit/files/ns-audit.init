# rsyslog is START=12, this instance feeds it
START=20
USE_PROCD=1

PROG="/usr/sbin/ulogd"
CONFFILE="/etc/ns-audit/ulogd.conf"
PIDFILE="/var/run/ns-audit.pid"

start_service() {
    procd_open_instance
    procd_set_param command $PROG -c "$CONFFILE" -p "$PIDFILE"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 0
    procd_close_instance
}

service_triggers()
{
    procd_add_reload_trigger ns-audit
}

reload_service()
{
    stop
    start
}
