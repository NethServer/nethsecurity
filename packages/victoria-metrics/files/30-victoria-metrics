#
# Triggered by hotplug when a block device is added or removed, after 10-mount.
# Restart to move the data onto the data storage when it gets mounted, or back to RAM when it goes away.

[ "$DEVTYPE" = "partition" ] || exit 0

target=$(uci -q get fstab.ns_data.target)
[ -n "$target" ] || exit 0

case "$ACTION" in
    add)
        grep -q "^/dev/$DEVNAME $target " /proc/mounts || exit 0
        ;;
    remove)
        grep -q " $target " /proc/mounts && exit 0
        pgrep -f "^/usr/bin/victoria-metrics .*-storageDataPath=$target/" >/dev/null || exit 0
        ;;
    *)
        exit 0
        ;;
esac

/etc/init.d/victoria-metrics running && /etc/init.d/victoria-metrics restart
exit 0
