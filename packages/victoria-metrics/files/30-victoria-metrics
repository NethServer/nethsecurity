#
# Triggered by hotplug when a block device is added, after 10-mount.
# If the data storage got mounted after boot, restart to move the data onto it.

[ "$ACTION" = "add" ] || exit 0
[ "$DEVTYPE" = "partition" ] || exit 0

target=$(uci -q get fstab.ns_data.target)
[ -n "$target" ] || exit 0
grep -q "^/dev/$DEVNAME $target " /proc/mounts || exit 0

/etc/init.d/victoria-metrics running && /etc/init.d/victoria-metrics restart
exit 0
