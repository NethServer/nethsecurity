# Remove data written to the root partition while the data storage wasn't mounted
[ -n "$(ls -A /overlay/upper/mnt/data 2>/dev/null)" ] || exit 0

services=""
for service in rsyslog dnsmasq victoria-metrics victoria-logs snort; do
    if [ -x "/etc/init.d/$service" ] && "/etc/init.d/$service" running; then
        "/etc/init.d/$service" stop
        services="$services $service"
    fi
done
if [ -n "$services" ]; then
    sync
    sleep 5
fi

# A non-recursive bind of / shows what's under /mnt/data without unmounting the storage
root=$(mktemp -d)
ret=1
if mount --bind / "$root"; then
    rm -rf "$root"/mnt/data/* "$root"/mnt/data/.[!.]*
    umount "$root"
    ret=0
fi
rmdir "$root"

for service in $services; do
    "/etc/init.d/$service" start
done
exit $ret
