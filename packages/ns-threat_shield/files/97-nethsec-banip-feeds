# Rebuild a non-empty banip.custom.feeds after an upgrade: it holds copies of banip.feeds (and banip.nethesis.feeds
# when registered), banIP reads only it. With banip.feeds still in the old format (rule_4) banip is not
# updated yet and its housekeeping rebuilds it later; the postinst reloads banIP after all the uci-defaults.

[ -s /etc/banip/banip.custom.feeds ] || exit 0
grep -q '"rule_4"' /etc/banip/banip.feeds && exit 0

/usr/sbin/ts-ip --no-start

exit 0
