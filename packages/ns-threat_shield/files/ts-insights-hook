# banip ban_blockhook: append a blocked IP to the spool, send-insights-blocklist sends it.
# Args: $1 IP; the other banip args ($2 family, $3 log count, $4 Set expiry) are not used

SPOOL_DIR="/var/run/ns-insights"
SPOOL="${SPOOL_DIR}/threat-events.jsonl"

[ -n "$1" ] || exit 0

[ -d "${SPOOL_DIR}" ] || mkdir -p "${SPOOL_DIR}"

printf '{"value":"%s","scope":"Ip","type":"ban","scenario":"nethsecurity/banip-log","origin":"banip","created_at":"%s"}\n' \
	"$1" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >>"${SPOOL}"
