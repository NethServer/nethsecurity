#
# Threat shield: add Nethesis categories to banip
#

. /lib/functions.sh

# URLs are expanded unquoted: no globbing
set -f

keep=''
custom='{}'
allow=''

handle_blocklist() {
    # preserve only non-enteprise lists
    if ! echo $1 | grep -q -E '^yoroi|^nethesis' ; then
        keep="$keep $1"
    fi
}

# custom blocklist: plain IP/CIDR list, one per line
handle_blockfeed() {
    local url_4 url_6 chain description
    config_get url_4 "$1" url_4
    config_get url_6 "$1" url_6
    config_get chain "$1" chain in
    config_get description "$1" description
    custom=$(printf '%s' "$custom" | jq -c --arg n "$1" --arg u4 "$url_4" --arg u6 "$url_6" --arg c "$chain" --arg d "$description" \
        '.[$n] = ({rule: "feed 1", chain: $c, descr: $d} + (if $u4 != "" then {url_4: $u4} else {} end) + (if $u6 != "" then {url_6: $u6} else {} end))')
}

handle_allowurl() {
    local url enabled
    config_get url "$1" url
    config_get_bool enabled "$1" enabled 1
    [ "$enabled" = "1" ] && [ -n "$url" ] && allow="$allow $url"
}


# replace the feeds file only with a complete and changed one: banIP drops ban_feed names missing from it
update_feeds() {
    if [ "$1" = "0" ] && [ -s "$FEEDS_TMP" ] && ! cmp -s "$FEEDS_TMP" "$FEEDS"; then
        mv -f "$FEEDS_TMP" "$FEEDS"
    fi
    rm -f "$FEEDS_TMP"
}

function exit_error {
    >&2 echo "[ERROR] $@"
    exit 1
}

INSIGHTS_SENDER=/usr/sbin/send-insights-blocklist
INSIGHTS_HOOK=/usr/libexec/ts-insights-hook
FEEDS=/etc/banip/banip.custom.feeds
FEEDS_TMP=/etc/banip/banip.custom.feeds.tmp

SYSTEM_SECRET=$(uci -q get ns-plug.config.secret)
SYSTEM_ID=$(uci -q get ns-plug.config.system_id)
TYPE=$(uci -q get ns-plug.config.type)

# migrate custom ban_allowurl entries first, a restored old backup is migrated again
/usr/libexec/ts-allowurl-migrate

# ts-ip owns ban_allowurl: the Nethesis allowlist (credentials rotate, never stored) plus enabled custom URLs;
# Nethesis first, banIP stops at the first failed download
if [ ! -z "$SYSTEM_SECRET" ] && [ ! -z "$SYSTEM_ID" ]; then
    allow="https://$SYSTEM_ID:$SYSTEM_SECRET@bl.nethesis.it/plain/$TYPE/nethesis-blacklists/whitelist.global"
fi
config_load banip
config_foreach handle_blockfeed ns_blockfeed
config_foreach handle_allowurl ns_allowurl
if [ "$(echo $allow)" != "$(uci -q get banip.global.ban_allowurl)" ]; then
    uci -q delete banip.global.ban_allowurl
    for url in $allow; do
        uci add_list banip.global.ban_allowurl="$url"
    done
    uci commit banip
fi

if [ ! -z "$SYSTEM_SECRET" ] && [ ! -z "$SYSTEM_ID" ]; then
    jq -s '.[0] * .[1]' /etc/banip/banip.nethesis.feeds /etc/banip/banip.feeds \
	    | sed -e "s/__USER__/$SYSTEM_ID/" -e "s/__PASSWORD__/$SYSTEM_SECRET/" -e "s/__TYPE__/$TYPE/" \
	    | jq --argjson c "$custom" '. + $c' > "$FEEDS_TMP"
    update_feeds $?
else
    # remove premium blocklist
    config_list_foreach global ban_feed handle_blocklist
    if [ "$(echo $keep)" != "$(uci -q get banip.global.ban_feed)" ]; then
        uci -q delete banip.global.ban_feed
        for k in $keep; do
            uci add_list banip.global.ban_feed=$k
        done
        uci commit banip
    fi
    if [ "$custom" = "{}" ]; then
        > /etc/banip/banip.custom.feeds
    else
        jq --argjson c "$custom" '. + $c' /etc/banip/banip.feeds > "$FEEDS_TMP"
        update_feeds $?
    fi
    # the Insights feed is removed with the other enterprise feeds, ts-insights-hook stops reporting;
    # remove the banip block hook and the sender cron job left by older releases, a custom hook is left untouched
    if [ "$(uci -q get banip.global.ban_blockhook)" = "$INSIGHTS_HOOK" ]; then
        uci -q delete banip.global.ban_blockhook
        uci commit banip
    fi
    if crontab -l 2>/dev/null | grep -q "$INSIGHTS_SENDER"; then
        crontab -l | grep -v "$INSIGHTS_SENDER" | crontab -
    fi
fi

# uci-defaults pass --no-start: no fail2ban (re)start during upgrades, rsyslog is down at first boot
/usr/libexec/ts-fail2ban "$@"
