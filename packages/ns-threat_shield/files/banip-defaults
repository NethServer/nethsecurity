[ "$(uci -q get banip.global.ban_loginbound)" != "" ] && exit 0

uci -q batch << EOI
set banip.global.ban_loginbound="1"
set banip.global.ban_logoutbound="1"
set banip.global.ban_logprerouting="0"

set banip.global.ban_loglimit="100"
set banip.global.ban_logcount="3"
set banip.global.ban_nftexpiry="30m"

delete banip.global.ban_logterm
add_list banip.global.ns_jails="ns-ssh"
add_list banip.global.ns_jails="ns-webui"
add_list banip.global.ns_jails="ns-openvpn"
add_list banip.global.ns_jails="ns-proxy-auth"
add_list banip.global.ns_jails="ns-proxy-scan"

set banip.global.ban_icmplimit="100"
set banip.global.ban_synlimit="10"
set banip.global.ban_udplimit="100"

commit banip
EOI
