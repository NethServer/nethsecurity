# Enable firewall_exemption on systems installed before it became the default, so DPI rules can not lock
# the administrator out of the unit.

if [ "$(uci -q get dpi.config.firewall_exemption)" != "1" ]; then
  uci -q set dpi.config.firewall_exemption='1'
  uci commit dpi
fi
