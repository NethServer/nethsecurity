# Keep the firewall_exemption list in sync with interface addresses that change at runtime (e.g. DHCP or
# PPPoE on WAN). Only netifyd is reloaded, never restarted, and only when the generated config changed.

[ "$ACTION" = "ifup" ] || { [ "$ACTION" = "ifupdate" ] && [ "$IFUPDATE_ADDRESSES" = "1" ]; } || exit 0
[ "$(uci -q get dpi.config.firewall_exemption)" = "1" ] || exit 0

cfg_file=/etc/netifyd/netify-proc-flow-actions.json

lock /var/lock/dpi-exemption.lock
before=$(md5sum "$cfg_file" 2>/dev/null)
/usr/sbin/dpi-config
after=$(md5sum "$cfg_file" 2>/dev/null)
lock -u /var/lock/dpi-exemption.lock

# a stopped agent (e.g. HA backup node) reads the updated file when it starts
if [ "$before" != "$after" ] && /etc/init.d/netifyd running; then
	/etc/init.d/netifyd reload
fi
