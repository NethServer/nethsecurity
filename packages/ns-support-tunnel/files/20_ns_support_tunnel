if [ -z "$(uci -q get support-tunnel.config.url)" ]; then
	uci -q import support-tunnel << EOI
config main 'config'
	option url 'wss://support.nethesis.it/api/tunnel'
	option system_key ''
	option system_secret ''
	option exclude_patterns ''
EOI
fi

if uci -q get support-tunnel.config.tls_insecure > /dev/null; then
	uci -q delete support-tunnel.config.tls_insecure
	uci commit support-tunnel
fi

exit 0
